# NeuroBridge Asha — server configuration
#
# Copy this file to `.env.local` for local development, or set the variables in
# your host's environment settings. `.env*` is git-ignored, so a real secret
# never reaches the repository.
#
# Every variable here is read on the server only. Nothing in this list may be
# given a `NEXT_PUBLIC_` prefix, and none of them belongs in client code, in
# HTML, or in a URL.

# --- Cloud assistance (the Maira provider) ----------------------------------
# Without these, /api/asha answers 503 "Asha cloud connection is not
# configured." The local communication controls keep working.
MAIRA_API_KEY=
MAIRA_PROJECT_KEY=
# Optional: pin a provider profile by id. Without them the adapter picks the
# profile whose name and model match the route it is serving.
MAIRA_CHAT_PROFILE_ID=
MAIRA_SPEECH_PROFILE_ID=
MAIRA_BILINGUAL_PROFILE_ID=
# Legacy override. Applies to chat only.
MAIRA_GPT_PROFILE_ID=

# --- Private storage --------------------------------------------------------
# Preferred: the private Supabase table. Run supabase/schema.sql once in the
# SQL Editor first. The secret is a server key; it must never be a browser
# key. With both set, /api/health reports storageProvider "supabase".
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Alternatively, the Vercel Blob token. With no Supabase and no Blob token
# the app boots but every store write fails at request time, so set one.
BLOB_READ_WRITE_TOKEN=

# --- Web push (optional) ----------------------------------------------------
# Without these, the caregiver's push button reports that push is not
# enabled. Push is best-effort and OS-dependent; it is not a dispatch service.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# --- The retention job ------------------------------------------------------
# Required by the daily /api/cleanup cron. With it unset the cron refuses
# every caller rather than running unprotected.
CRON_SECRET=

# --- Local development ------------------------------------------------------
# In-memory storage only. Ignored when NODE_ENV is production unless
# ASHA_MEMORY_STORE_PRODUCTION is also set. Data is lost on restart.
ASHA_MEMORY_STORE=1
# Allows 127.0.0.1 as a CORS origin.
LOCAL_DEV=1
# The HTTPS certificate directory for `npm run serve:lan`. Defaults to .certs.
# ASHA_CERT_DIR=

# --- Browser tests ----------------------------------------------------------
# The base URL the browser suites talk to. Defaults to http://127.0.0.1:4180.
# NEXT_TEST_URL=http://127.0.0.1:4180
# A Playwright install outside node_modules, and a Chrome binary, for a
# machine where the bundled ones do not run.
# PLAYWRIGHT_MODULE=
# CHROME_PATH=
